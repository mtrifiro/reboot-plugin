#!/usr/bin/env sh
#
# Reboot Claude Code plugin: `node` bootstrap shim.
#
# Claude Code prepends this script's directory to the agent's `PATH`, so
# the agent's `node ...` invocations land here. Sibling of
# `bin/npm`; both delegate to `lib/install_node.sh` and exec
# binaries from the same cached Node install.

set -eu

# The plugin's root: `$CLAUDE_PLUGIN_ROOT`, else from this script's own
# path through any symlink (see `bin/rbt`).
self="$0"
while [ -L "$self" ]; do
    link="$(readlink "$self")"
    case "$link" in
        /*) self="$link" ;;
        *) self="$(dirname -- "$self")/$link" ;;
    esac
done
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname -- "$self")/.." && pwd)}"
if [ ! -f "$PLUGIN_ROOT/lib/install_node.sh" ]; then
    echo "node: $PLUGIN_ROOT/lib/ is missing (this shim is $self; the plugin's lib/ must sit beside its bin/). Reinstall the plugin, or set CLAUDE_PLUGIN_ROOT to its directory." >&2
    exit 1
fi

NODE_DIR="$("$PLUGIN_ROOT/lib/install_node.sh")"

exec "$NODE_DIR/bin/node" "$@"
