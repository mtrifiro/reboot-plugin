#!/usr/bin/env sh
#
# Reboot Claude Code plugin: `envoy` bootstrap shim.
#
# Claude Code prepends this script's directory to the agent's `PATH`, so
# the agent's `envoy ...` invocations land here. Delegates
# to `lib/install_envoy.sh` and execs the cached `envoy` binary.

set -eu

# The plugin's root: `$CLAUDE_PLUGIN_ROOT`, else from this script's own
# path through any symlink (see `bin/rbt`).
self="$0"
while [ -L "$self" ]; do
    link="$(readlink "$self")"
    case "$link" in
        /*) self="$link" ;;
        *) self="$(dirname -- "$self")/$link" ;;
    esac
done
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname -- "$self")/.." && pwd)}"
if [ ! -f "$PLUGIN_ROOT/lib/install_envoy.sh" ]; then
    echo "envoy: $PLUGIN_ROOT/lib/ is missing (this shim is $self; the plugin's lib/ must sit beside its bin/). Reinstall the plugin, or set CLAUDE_PLUGIN_ROOT to its directory." >&2
    exit 1
fi

ENVOY_DIR="$("$PLUGIN_ROOT/lib/install_envoy.sh")"

exec "$ENVOY_DIR/envoy" "$@"
