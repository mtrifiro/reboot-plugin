#!/usr/bin/env sh
#
# Reboot Claude Code plugin: `cloudflared` bootstrap shim.
#
# Claude Code prepends this script's directory to the agent's `PATH`,
# so the agent's `cloudflared ...` invocations land here. Delegates
# to `lib/install_cloudflared.sh` and execs the cached binary.

set -eu

# The plugin's root: `$CLAUDE_PLUGIN_ROOT`, else from this script's own
# path through any symlink (see `bin/rbt`).
self="$0"
while [ -L "$self" ]; do
    link="$(readlink "$self")"
    case "$link" in
        /*) self="$link" ;;
        *) self="$(dirname -- "$self")/$link" ;;
    esac
done
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname -- "$self")/.." && pwd)}"
if [ ! -f "$PLUGIN_ROOT/lib/install_cloudflared.sh" ]; then
    echo "cloudflared: $PLUGIN_ROOT/lib/ is missing (this shim is $self; the plugin's lib/ must sit beside its bin/). Reinstall the plugin, or set CLAUDE_PLUGIN_ROOT to its directory." >&2
    exit 1
fi

CLOUDFLARED_DIR="$("$PLUGIN_ROOT/lib/install_cloudflared.sh")"

# Record which agent session owns a long-running dev command; see
# `lib/own.sh`. Never fails this shim.
"$PLUGIN_ROOT/lib/own.sh" $$ cloudflared "$@" || true

exec "$CLOUDFLARED_DIR/cloudflared" "$@"
