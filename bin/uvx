#!/usr/bin/env sh
#
# Reboot Claude Code plugin: `uvx` bootstrap shim.
#
# Claude Code prepends this script's directory to the agent's `PATH`, so
# the agent's `uvx ...` invocations land here. We delegate install
# management to `lib/install_uv.sh`, then exec the cached `uvx` binary.
# The first call installs; later calls are a single subshell stat away
# from the real `uvx`.

set -eu

# The plugin's root: `$CLAUDE_PLUGIN_ROOT`, else from this script's own
# path through any symlink (see `bin/rbt`).
self="$0"
while [ -L "$self" ]; do
    link="$(readlink "$self")"
    case "$link" in
        /*) self="$link" ;;
        *) self="$(dirname -- "$self")/$link" ;;
    esac
done
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname -- "$self")/.." && pwd)}"
if [ ! -f "$PLUGIN_ROOT/lib/install_uv.sh" ]; then
    echo "uvx: $PLUGIN_ROOT/lib/ is missing (this shim is $self; the plugin's lib/ must sit beside its bin/). Reinstall the plugin, or set CLAUDE_PLUGIN_ROOT to its directory." >&2
    exit 1
fi

UV_DIR="$("$PLUGIN_ROOT/lib/install_uv.sh")"
exec "$UV_DIR/uvx" "$@"
