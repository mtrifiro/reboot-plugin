#!/usr/bin/env sh
# The build's step line, for the progress band above the prompt, never
# for the chat (the build skill, "How the build talks"):
#
#   reboot-now Reading how Reboot defines objects and methods
#
# It says what the work is for in the user's terms, never the plugin's:
# no step, reference or reading list.
#
# Plain words, no quotes: letters, digits, ,.:/_- and the typographic
# apostrophe ’, never the plain one, which the shell reads as a quote.
# The plugin's auto-approve hook then lets it through without a prompt.
# The band reads the line from the command itself. This does nothing
# else.
exit 0
