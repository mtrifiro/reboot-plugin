#!/usr/bin/env sh
#
# Reboot Claude Code plugin: `uv` bootstrap shim.
#
# Claude Code prepends this script's directory to the agent's `PATH`, so
# the agent's `uv ...` invocations land here. Sibling of
# `bin/uvx`; both delegate to `lib/install_uv.sh` and exec into
# the same cached install directory.

set -eu

# The plugin's root: `$CLAUDE_PLUGIN_ROOT`, else from this script's own
# path through any symlink (see `bin/rbt`).
self="$0"
while [ -L "$self" ]; do
    link="$(readlink "$self")"
    case "$link" in
        /*) self="$link" ;;
        *) self="$(dirname -- "$self")/$link" ;;
    esac
done
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname -- "$self")/.." && pwd)}"
if [ ! -f "$PLUGIN_ROOT/lib/install_uv.sh" ]; then
    echo "uv: $PLUGIN_ROOT/lib/ is missing (this shim is $self; the plugin's lib/ must sit beside its bin/). Reinstall the plugin, or set CLAUDE_PLUGIN_ROOT to its directory." >&2
    exit 1
fi

# `uv run rbt dashboard`: the dashboard's pyright runs out of Node's
# default heap on a mid-sized app and keeps retrying (finding P1.12);
# give it room unless the caller chose.
previous=""
for arg in "$@"; do
    if [ "$previous" = "rbt" ] && [ "$arg" = "dashboard" ] && [ -z "${NODE_OPTIONS:-}" ]; then
        export NODE_OPTIONS="--max-old-space-size=12288"
    fi
    previous="$arg"
done

UV_DIR="$("$PLUGIN_ROOT/lib/install_uv.sh")"

# Record which agent session owns a long-running dev command; see
# `lib/own.sh`. Never fails this shim.
"$PLUGIN_ROOT/lib/own.sh" $$ uv "$@" || true

exec "$UV_DIR/uv" "$@"
