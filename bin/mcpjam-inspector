#!/usr/bin/env sh
#
# Reboot Claude Code plugin: `mcpjam-inspector` shim.
#
# Claude Code prepends this script's directory to the agent's `PATH`,
# so the agent's `mcpjam-inspector ...` invocations land here. We
# launch MCPJam's inspector via the plugin's pinned Node + npm cache,
# pinning the inspector version in one place and passing `--no-open`
# so the inspector doesn't pop a browser tab. (The agent surfaces the
# URL to the user in plain text instead; see the MCPJam section of
# the `run` skill, which uses this shim for the on-demand launch.)
# `--no-open` requires inspector >= 2.5.0.

set -eu

# The plugin's root: `$CLAUDE_PLUGIN_ROOT`, else from this script's own
# path through any symlink (see `bin/rbt`).
self="$0"
while [ -L "$self" ]; do
    link="$(readlink "$self")"
    case "$link" in
        /*) self="$link" ;;
        *) self="$(dirname -- "$self")/$link" ;;
    esac
done
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname -- "$self")/.." && pwd)}"
if [ ! -f "$PLUGIN_ROOT/lib/install_node.sh" ]; then
    echo "mcpjam-inspector: $PLUGIN_ROOT/lib/ is missing (this shim is $self; the plugin's lib/ must sit beside its bin/). Reinstall the plugin, or set CLAUDE_PLUGIN_ROOT to its directory." >&2
    exit 1
fi

NODE_DIR="$("$PLUGIN_ROOT/lib/install_node.sh")"

# Record which agent session owns a long-running dev command; see
# `lib/own.sh`. Never fails this shim.
"$PLUGIN_ROOT/lib/own.sh" $$ mcpjam-inspector "$@" || true

exec "$NODE_DIR/bin/npx" @mcpjam/inspector@2.18.1 --no-open "$@"
