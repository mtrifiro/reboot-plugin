# `.rbtrc` is line-based: `<subcommand> <flag>`, not YAML.
# See `python/references/lifecycle-rbtrc.md`.

# Find API definitions in 'api/'. `rbt dev run` also regenerates
# and restarts when a file under 'api/' changes (`--generate-watch`
# is on by default), so 'api/' needs no `--watch` line.
generate api/

# Tell `rbt generate` where to put generated files.
generate --python=backend/api/

# Generate React bindings for the UIs (into "frontend/api/").
generate --react=frontend/api

# Watch if any source files are modified.
dev run --watch=backend/**/*.py

# Tell `rbt` that this is a Python application.
dev run --python

# Save state between restarts.
dev run --application-name=__project__

# Load secrets from a git-ignored env file. Put one KEY=VALUE line
# per secret in `.env`. See `python/references/lifecycle-secrets.md`.
dev run --env-file=.env

# Run the application!
dev run --application=backend/src/main.py

# Default to HMR mode when no --config is specified.
dev run --default-config=hmr

# HMR: Vite dev server proxied through Envoy.
# Run Vite in a separate terminal: cd frontend && npm run dev
# Envoy routes "/__/frontend/**" to Vite for HMR support.
dev run --frontend-root-path=frontend

dev run:hmr --frontend-host=http://localhost:4444

# Dist mode: serve pre-built artifacts from "frontend/dist/" (no Vite HMR).
# Usage: rbt dev run --config=dist
# Requires: cd frontend && npm run build
dev run:dist --frontend-dist-path=frontend/dist

# When expunging, expunge that state we've saved.
dev expunge --application-name=__project__

# Production config used by `rbt serve run` (and so by Reboot Cloud,
# whose containers run `CMD ["rbt", "serve", "run"]`). Mirrors the
# `dev run` block above, minus the dev-only knobs (`--watch`,
# `--env-file`, the `:hmr`/`:dist` configs).
serve run --python
serve run --frontend-dist-path=frontend/dist --frontend-root-path=frontend
serve run --application=backend/src/main.py
serve run --application-name=__project__
serve run --tls=external
