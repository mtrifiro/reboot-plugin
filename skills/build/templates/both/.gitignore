backend/api/
frontend/api/

# Secrets; see `python/references/lifecycle-secrets.md`.
.env

# Recordings of browser scenarios, made by running the tests.
*.recordings/

# Python virtual environment and caches.
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/

# Frontend dependencies and build output.
node_modules/
frontend/dist/

# Design-review screenshots, made by scripts/screenshots.py.
screenshots/

# How far a test run is, for the Reboot band (tests/run_progress.py).
.reboot/
